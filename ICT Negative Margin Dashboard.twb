    <worksheet name='YTD Review Vert (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Neg Margin Correction Progress vs Baseline</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TPrep NegMarg Output no Filter Extract' name='federated.1wq0a5b0htqxcj1eifrc51agylzu' />
            <datasource caption='TPrep NegMarg Output no Filter Extract (2)' name='federated.1wq0a5b0htqxcj1eifrc51agylzu (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1wq0a5b0htqxcj1eifrc51agylzu'>
            <column caption='-Improvements' datatype='real' hidden='true' name='[+Improvements (copy)_1894326598138515485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1894326597948436486]-ifnull([Negative Margin % of Total Sales (copy)_1445936974743019521],0))*sum([Sales Amount - Budget Rate (C$)])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='+Improvements Vert' datatype='real' name='[+Improvements (copy)_619244969569308673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ifnull([Calculation_1894326597948436486],0)-ifnull([Negative Margin % of Total Sales (copy)_1445936974743019521] ,0))*sum([Sales Amount - Budget Rate (C$)])*-1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='-Improvements Vert' datatype='real' name='[-Improvements (copy 2)_619244969570443267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1894326597948436486]-ifnull([Negative Margin % of Total Sales (copy)_1445936974743019521],0))*sum([Sales Amount - Budget Rate (C$)])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CBC2 Hier' datatype='string' name='[CBC2 (copy)_1283807372286238722]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([CBC2 Old (copy)_946318936476921856]=&quot;High Voltage&quot;,&quot;E mobility&quot;,[Calculation_153685351135780865])' />
            </column>
            <column caption='CBC3' datatype='string' name='[CBC2 Old (copy)_946318936476921856]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REGEXP_REPLACE(&#13;&#10;REGEXP_REPLACE(&#13;&#10;&#13;&#10;REGEXP_REPLACE( [Product Structure Level 3 Name (CBC3)],&apos;ICT &apos;,&apos;&apos;)&#13;&#10;,&apos;_&apos;,&apos; &apos;)&#13;&#10;,&apos;-&apos;,&apos; &apos;)' />
            </column>
            <column caption='CBC2 Owner Hier' datatype='string' name='[CBC2 Owner (copy)_1283807372286689286]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case([Calculation_231090971472121856])&#13;&#10;when &quot;C/Assy  &amp; Value Add&quot; Then &quot;Jason Cheng&quot;&#13;&#10;when &quot;Data Connectivity&quot; Then &quot;Kirsten Linthwaite&quot;&#13;&#10;when &quot;Electro Mechanical&quot; Then &quot;Harz Moritz&quot;&#13;&#10;when &quot;HEMS&quot; Then &quot;Eric Hoffman&quot;&#13;&#10;when &quot;E mobility&quot; Then &quot;Eric Hoffman&quot;&#13;&#10;when &quot;Round Contact Systems&quot; Then &quot;David Procter&quot;&#13;&#10;when &quot;Stamped contacts systems&quot; Then &quot;Seven Xue&quot;&#13;&#10;&#13;&#10;else &quot;?&quot; end' />
            </column>
            <column caption='CBC3 Hier' datatype='string' name='[CBC3 (copy)_1283807372286304259]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REGEXP_REPLACE(&#13;&#10;REGEXP_REPLACE(&#13;&#10;&#13;&#10;REGEXP_REPLACE( [Product Structure Level 3 Name (CBC3)],&apos;ICT &apos;,&apos;&apos;)&#13;&#10;,&apos;_&apos;,&apos; &apos;)&#13;&#10;,&apos;-&apos;,&apos; &apos;)' />
            </column>
            <column caption='Running Sum Sales' datatype='real' hidden='true' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales Amount - Budget Rate (C$)]))'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='Neg Margin Running Sum' datatype='real' hidden='true' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM(ifnull([Positive margin (copy)_1894326597947252739],0)))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Fiscal Date' datatype='date' name='[Calculation_1232860433775681536]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(str([Fiscal Month Short Number])+&quot;/01/&quot;+str([Fiscal Year]))' />
            </column>
            <column caption='Worldwide Label' datatype='string' name='[Calculation_1232860433776705539]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Worldwide Customer Level 1]+&quot; - &quot;+[Worldwide Customer Level 1 Name]' />
            </column>
            <column caption='MIn Fiscal Month Label Filter' datatype='string' name='[Calculation_1496320989571964930]' role='measure' type='nominal'>
              <calculation class='tableau' formula='lookup(min([Fiscal Month Label]),0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CBC2 Owner' datatype='string' name='[Calculation_153685351134724096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case([Calculation_231090971472121856])&#13;&#10;when &quot;C/Assy  &amp; Value Add&quot; Then &quot;Jason Cheng&quot;&#13;&#10;when &quot;Data Connectivity&quot; Then &quot;Kirsten Linthwaite&quot;&#13;&#10;when &quot;Electro Mechanical&quot; Then &quot;Harz Moritz&quot;&#13;&#10;when &quot;HEMS&quot; Then &quot;Eric Hoffman&quot;&#13;&#10;when &quot;E mobility&quot; Then &quot;Eric Hoffman&quot;&#13;&#10;when &quot;Round Contact Systems&quot; Then &quot;David Procter&quot;&#13;&#10;when &quot;Stamped contacts systems&quot; Then &quot;Seven Xue&quot;&#13;&#10;&#13;&#10;else &quot;?&quot; end' />
            </column>
            <column caption='CBC2 Old' datatype='string' name='[Calculation_153685351135780865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REGEXP_REPLACE(&#13;&#10;REGEXP_REPLACE(&#13;&#10;&#13;&#10;REGEXP_REPLACE( [Product Structure Level 2 Name (CBC2)],&apos;ICT &apos;,&apos;&apos;)&#13;&#10;,&apos;_&apos;,&apos; &apos;)&#13;&#10;,&apos;-&apos;,&apos; &apos;)' />
            </column>
            <column caption='GPL NAME' datatype='string' name='[Calculation_153685351136026627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REGEXP_REPLACE(&#13;&#10;REGEXP_REPLACE(&#13;&#10;REGEXP_REPLACE( [Product Line Name (GPL)],&apos;ICT &apos;,&apos;&apos;)&#13;&#10;,&apos;_&apos;,&apos; &apos;)&#13;&#10;,&apos;-&apos;,&apos; &apos;)' />
            </column>
            <column caption='GPL ' datatype='string' hidden='true' name='[Calculation_153685351136157700]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([Product Line (GPL)]=&quot;J21&quot; and left([Material Number],2)=&quot;9-&quot;,&quot;J21T&quot;,[Product Line (GPL)])' />
            </column>
            <column caption='PART MARGIN' datatype='real' hidden='true' name='[Calculation_153685351136772103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Sales Authoritative Margin - Budget Rate (C$)]' />
            </column>
            <column caption='Fiscal Month Name' datatype='string' name='[Calculation_1693634939828477952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='right(REPLACE([Fiscal Month Label],&quot;-&quot;,&quot; &quot;),len(REPLACE([Fiscal Month Label],&quot;-&quot;,&quot; &quot;))-5)' />
            </column>
            <column caption='Pos or Neg' datatype='string' hidden='true' name='[Calculation_1894326597946052608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([Fixed Margin % Monthly (copy)_1283807372285628416]=True,&quot;Negative Margin&quot;,&quot;Positive Margin&quot;)' />
            </column>
            <column caption='Neg Marg YTD %' datatype='real' hidden='true' name='[Calculation_1894326597947465732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation2]/([Calculation1]-[Calculation2])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='First Negative Margin' datatype='real' hidden='true' name='[Calculation_1894326597948436486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='lookup([Calculation_1894326597947465732],first())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Actual' datatype='string' name='[Calculation_1894326598130327574]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;YTD Negative Margin&quot;' />
            </column>
            <column caption='Estimated Delta' datatype='string' name='[Calculation_1894326598130479127]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Correction Progress&quot;' />
            </column>
            <column caption='Improvements_' datatype='real' hidden='true' name='[Calculation_1894326598137335836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[+Improvements (copy)_1894326598138515485]+PREVIOUS_VALUE(0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Overall Improvement % of Overall Neg Margin' datatype='real' name='[Calculation_1894326598145953825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Improvements_ (copy)_619244969569841154]/&#13;&#10;(&#13;&#10;[Calculation2]&#13;&#10;+[Improvements_ (copy)_619244969569841154])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Actuals_' datatype='real' hidden='true' name='[Calculation_1894326598163427371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation2]'>
                <table-calc ordering-type='Rows' />
