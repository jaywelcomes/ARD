      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TPrep NegMarg Output no Filter Extract' name='federated.1wq0a5b0htqxcj1eifrc51agylzu' />
            <datasource caption='TPrep NegMarg Output no Filter Extract (2)' name='federated.1wq0a5b0htqxcj1eifrc51agylzu (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1wq0a5b0htqxcj1eifrc51agylzu'>
            <column caption='-Improvements' datatype='real' hidden='true' name='[+Improvements (copy)_1894326598138515485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1894326597948436486]-ifnull([Negative Margin % of Total Sales (copy)_1445936974743019521],0))*sum([Sales Amount - Budget Rate (C$)])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CBC2 Hier' datatype='string' name='[CBC2 (copy)_1283807372286238722]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([CBC2 Old (copy)_946318936476921856]=&quot;High Voltage&quot;,&quot;E mobility&quot;,[Calculation_153685351135780865])' />
            </column>
            <column caption='CBC3' datatype='string' name='[CBC2 Old (copy)_946318936476921856]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REGEXP_REPLACE(&#13;&#10;REGEXP_REPLACE(&#13;&#10;&#13;&#10;REGEXP_REPLACE( [Product Structure Level 3 Name (CBC3)],&apos;ICT &apos;,&apos;&apos;)&#13;&#10;,&apos;_&apos;,&apos; &apos;)&#13;&#10;,&apos;-&apos;,&apos; &apos;)' />
            </column>
            <column caption='CBC2 Owner Hier' datatype='string' name='[CBC2 Owner (copy)_1283807372286689286]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case([Calculation_231090971472121856])&#13;&#10;when &quot;C/Assy  &amp; Value Add&quot; Then &quot;Jason Cheng&quot;&#13;&#10;when &quot;Data Connectivity&quot; Then &quot;Kirsten Linthwaite&quot;&#13;&#10;when &quot;Electro Mechanical&quot; Then &quot;Harz Moritz&quot;&#13;&#10;when &quot;HEMS&quot; Then &quot;Eric Hoffman&quot;&#13;&#10;when &quot;E mobility&quot; Then &quot;Eric Hoffman&quot;&#13;&#10;when &quot;Round Contact Systems&quot; Then &quot;David Procter&quot;&#13;&#10;when &quot;Stamped contacts systems&quot; Then &quot;Seven Xue&quot;&#13;&#10;&#13;&#10;else &quot;?&quot; end' />
            </column>
            <column caption='CBC3 Hier' datatype='string' name='[CBC3 (copy)_1283807372286304259]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REGEXP_REPLACE(&#13;&#10;REGEXP_REPLACE(&#13;&#10;&#13;&#10;REGEXP_REPLACE( [Product Structure Level 3 Name (CBC3)],&apos;ICT &apos;,&apos;&apos;)&#13;&#10;,&apos;_&apos;,&apos; &apos;)&#13;&#10;,&apos;-&apos;,&apos; &apos;)' />
            </column>
            <column caption='Running Sum Sales' datatype='real' hidden='true' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales Amount - Budget Rate (C$)]))'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='Neg Margin Running Sum' datatype='real' hidden='true' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM(ifnull([Positive margin (copy)_1894326597947252739],0)))'>
                <table-calc ordering-type='Rows' />
              </calculation>
