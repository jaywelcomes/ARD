              <calculation class='tableau' formula='case([Calculation_231090971472121856])&#13;&#10;when &quot;C/Assy  &amp; Value Add&quot; Then &quot;Jason Cheng&quot;&#13;&#10;when &quot;Data Connectivity&quot; Then &quot;Kirsten Linthwaite&quot;&#13;&#10;when &quot;Electro Mechanical&quot; Then &quot;Harz Moritz&quot;&#13;&#10;when &quot;HEMS&quot; Then &quot;Eric Hoffman&quot;&#13;&#10;when &quot;E mobility&quot; Then &quot;Eric Hoffman&quot;&#13;&#10;when &quot;Round Contact Systems&quot; Then &quot;David Procter&quot;&#13;&#10;when &quot;Stamped contacts systems&quot; Then &quot;Seven Xue&quot;&#13;&#10;&#13;&#10;else &quot;?&quot; end' />
